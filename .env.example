# ==============================================================================
# Environment Configuration Template for Campus Lost & Found System
# Rename this file to '.env' and populate the values for deployment.
# ==============================================================================

# HTTP Listening Port
HTTP_PORT=8080

# Database Configuration
MONGO_URI=mongodb+srv://rohancherian2024_db_user:tZFNDr8kOAq3ifac@cluster0.iwdrcvy.mongodb.net/?appName=Cluster0
MONGO_DATABASE=campus_lost_found

# CORS Policy Configuration
CORS_ORIGIN=http://localhost:4200

# JWT Authentication Config (MANDATORY & VALIDATED AT STARTUP)
# ------------------------------------------------------------------------------
# Requirements:
# 1. Must be provided at startup.
# 2. Must not be empty.
# 3. Minimum length: 32 characters (64+ recommended for HS256 security).
# 
# Example generation commands:
# - openssl rand -base64 48
# - pwgen -s 64 1
# ------------------------------------------------------------------------------
JWT_SECRET=super_secure_random_secret_string_minimum_64_chars_long_2026_campus_lost_found

# Default Admin User Seeding Config (MANDATORY & VALIDATED AT STARTUP)
# ------------------------------------------------------------------------------
# Requirements:
# 1. Must be provided at startup.
# 2. Must not be empty.
# 3. Minimum length: 12 characters (16+ recommended for security compliance).
# ------------------------------------------------------------------------------
ADMIN_SEED_PASSWORD=replace-with-secure-password-minimum-12-chars
