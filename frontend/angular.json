{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"shell-app": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:class": {
					"skipTests": true
				},
				"@schematics/angular:component": {
					"skipTests": true,
					"standalone": true
				},
				"@schematics/angular:directive": {
					"skipTests": true,
					"standalone": true
				},
				"@schematics/angular:guard": {
					"skipTests": true
				},
				"@schematics/angular:interceptor": {
					"skipTests": true
				},
				"@schematics/angular:pipe": {
					"skipTests": true,
					"standalone": true
				},
				"@schematics/angular:resolver": {
					"skipTests": true
				},
				"@schematics/angular:service": {
					"skipTests": true
				}
			},
			"root": "projects/shell-app",
			"sourceRoot": "projects/shell-app/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist/shell-app",
						"index": "projects/shell-app/src/index.html",
						"main": "projects/shell-app/src/main.ts",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "projects/shell-app/tsconfig.app.json",
						"assets": [
							"projects/shell-app/src/favicon.ico",
							"projects/shell-app/src/assets"
						],
						"styles": [
							"projects/shell-app/src/styles.css"
						],
						"scripts": [],
						"extraWebpackConfig": "projects/shell-app/webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kb",
									"maximumError": "1mb"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "2kb",
									"maximumError": "4kb"
								}
							],
							"outputHashing": "all",
							"extraWebpackConfig": "projects/shell-app/webpack.prod.config.js"
						},
						"development": {
							"buildOptimizer": false,
							"optimization": false,
							"vendorChunk": true,
							"extractLicenses": false,
							"sourceMap": true,
							"namedChunks": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"browserTarget": "shell-app:build:production",
							"extraWebpackConfig": "projects/shell-app/webpack.prod.config.js"
						},
						"development": {
							"browserTarget": "shell-app:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200,
						"publicHost": "http://localhost:4200",
						"extraWebpackConfig": "projects/shell-app/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "ngx-build-plus:extract-i18n",
					"options": {
						"browserTarget": "shell-app:build",
						"extraWebpackConfig": "projects/shell-app/webpack.config.js"
					}
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/shell-app/tsconfig.spec.json",
						"assets": [
							"projects/shell-app/src/favicon.ico",
							"projects/shell-app/src/assets"
						],
						"styles": [
							"projects/shell-app/src/styles.css"
						],
						"scripts": []
					}
				}
			}
		},
